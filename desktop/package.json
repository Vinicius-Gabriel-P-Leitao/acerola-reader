{
	"name": "acerola",
	"type": "module",
	"version": "0.0.1-beta",
	"license": "GPL-3.0-only",
	"author": {
		"name": "Vinícius Gabriel Pereira Leitão",
		"email": "contato@acerola-comic.com"
	},
	"description": "Aplicativo para ler e gerenciar bibliotecas de quadrinhos locais.",
	"scripts": {
		"tauri": "tauri",
		"tauri:dev:withidentity": "cargo build --manifest-path src-tauri/Cargo.toml && (if not exist dist mkdir dist) && copy /Y src-tauri\\target\\debug\\acerola.exe dist\\ >nul && winapp run .\\dist",
		"pack:msix": "npm run tauri -- build && (if not exist dist mkdir dist) && copy /Y src-tauri\\target\\release\\acerola.exe dist\\ >nul && winapp pack .\\dist --cert .\\devcert.pfx",
		"make": "cargo make --cwd ./src-tauri",
		"preview": "vite preview",
		"dev": "npm run paraglide:compile && vite dev",
		"build": "npm run paraglide:compile && vite build",
		"check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"storybook": "npm run paraglide:compile && storybook dev -p 6006",
		"build-storybook": "npm run paraglide:compile && storybook build",
		"paraglide:compile": "paraglide-js compile --project ./svelte/project.inlang --outdir ./svelte/src/lib/paraglide",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --project=unit",
		"test:coverage": "vitest run --coverage",
		"test:unit:watch": "vitest --project=unit",
		"test:storybook": "vitest run --project=storybook",
		"test:storybook:watch": "vitest --project=storybook",
		"test:coverage:unit": "vitest run --project=unit --coverage",
		"test:wdio": "wdio run wdio.conf.ts",
		"test:ui": "vitest --ui",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.6.0",
		"@tauri-apps/plugin-fs": "^2.5.0",
		"@tauri-apps/plugin-log": "^2.8.0",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-sql": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.4.2"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/noto-serif": "^5.2.9",
		"@inlang/paraglide-js": "^2.10.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.7.0",
		"@poppanator/sveltekit-svg": "^6.0.1",
		"@storybook/addon-a11y": "^10.4.4",
		"@storybook/addon-docs": "^10.4.4",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.4.4",
		"@storybook/sveltekit": "^10.4.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.1.18",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/jest": "^30.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.13.2",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.0",
		"@wdio/cli": "^9.27.2",
		"@wdio/local-runner": "^9.27.2",
		"@wdio/mocha-framework": "^7.7.3",
		"@wdio/spec-reporter": "^9.27.2",
		"@wdio/types": "^9.27.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"jsdom": "^29.0.1",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.2.6",
		"storybook": "^10.4.4",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.6.2",
		"vite": "^8.0.16",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2",
		"webdriverio": "^9.27.2"
	}
}
